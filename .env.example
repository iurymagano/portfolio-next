# Opcional. Com token, o histórico vem pela API GraphQL do GitHub com SHA e contagem de commits ao vivo.
# Sem token, usa a API REST pública e completa SHA/commits com src/data/github-snapshot.json.
# Basta um token clássico sem nenhum escopo (só lê dados públicos).
GITHUB_TOKEN=

# URL pública do site, usada nas meta tags de compartilhamento
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com
